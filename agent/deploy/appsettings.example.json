// NodeWatch beállításai. Helye: /etc/nodewatch/appsettings.json
// A titkok (tokenek) NEM ide kerülnek, hanem külön fájlokba (0640, root:nodewatch), ide csak az útvonaluk.
{
  "Node": {
    "Name": "my-mosaic-node",
    "Network": "mosaic-mainnet",
    // A validátor SS58 címe (vagy 0x… nyilvános kulcsa). Üresen hagyva nincs validátorállapot-figyelés.
    "ValidatorAddress": "",
    // A beágyazott relay chain RPC-je (a Mosaic a 9954-es porton futtatja, csak biztonságos hívásokkal).
    "RelayRpc": "http://127.0.0.1:9954",
    "ParaRpc": "http://127.0.0.1:9944",
    "DataPath": "/var/lib/mosaic-mainnet",
    // Az első a chain (leállása kritikus), a többi csak figyelmeztet.
    "Services": [ "mosaic-chain-mainnet.service", "mosaic-indexer-mainnet.service" ]
  },

  "Checks": {
    "IntervalSeconds": 30,
    "RelayStallMinutes": 3,
    "FinalityStallMinutes": 5,
    "SyncWarnMinutes": 10,
    "ReminderMinutes": 30,
    "ConfirmPolls": 2,
    "DiskWarnPercent": 15,
    "DiskCriticalPercent": 5
  },

  // A riasztásokban szereplő időpontok és a napi összesítés időzónája (üresen: a rendszeré, ami a node-on UTC).
  "TimeZone": "Europe/Budapest",

  // Watchdog: ha a felsorolt ellenőrzések valamelyike AfterMinutes percig folyamatosan kritikus, újraindítja a chain
  // szolgáltatást; az ImmediateTriggers azonnal. Legfeljebb MinHoursBetween óránként egyszer és naponta MaxPerDay-szer
  // (0: nincs napi korlát).
  "Restart": {
    "Enabled": true,
    "AfterMinutes": 10,
    "MinHoursBetween": 1,
    "MaxPerDay": 6,
    "GraceMinutes": 15,
    "Unit": "mosaic-chain-mainnet.service",
    "Command": [ "systemctl", "--no-ask-password", "--no-block", "restart", "mosaic-chain-mainnet.service" ],
    "Triggers": [ "relay.rpc", "relay.block_progress", "relay.full_peers", "para.rpc", "para.finality",
                  "validator.missed_slots", "validator.offline_risk" ],
    "ImmediateTriggers": [ "validator.missed_slots", "validator.offline_risk" ],
    "SkipWhileUnitsActive": [ "update-mosaic.service" ]
  },

  // A session-kiválasztás figyelése (csak ha a ValidatorAddress meg van adva).
  "Selection": {
    "Enabled": true,
    // Info üzenet, amikor a következő sessionre kiválasztják (a kimenet MinSeverity-je legyen "info").
    "NotifySelected": true,
    // Napi összesítés ennyi órakor (TimeZone szerint); -1: nincs.
    "DailySummaryHour": 8,
    // Figyelmeztetés, ha a (nem chillelt) validátort ennyi órája nem választották ki; 0: ki.
    "NotSelectedAlertHours": 24,
    // Ennyi egymás utáni saját blokkhely maradt üresen: kritikus + azonnali újraindítás (egy üres hely csak figyelmeztetés).
    "MissedSlotsBeforeRestart": 2,
    // Ha az egész láncon ennyinél nagyobb része üres a slotoknak (utolsó 5 perc), a kihagyott blokk nem a node hibája.
    "ChainEmptySlotsLimit": 0.25,
    // Ha a session ennyi részénél (0–1) még nincs blokk és életjel sem: kritikus + azonnali újraindítás.
    "OfflineRiskProgress": 0.85
  },

  // direct: közvetlenül a Sinks kimenetekre; relay: csak a relay-re; both: relay + tartalék kimenetek.
  "Mode": "direct",

  "Relay": {
    "Url": "",
    "NodeTokenFile": "",
    "FallbackAfterMinutes": 2,
    "HeartbeatSeconds": 60,
    "Channels": []
  },

  "Sinks": [
    {
      "Type": "telegram",
      "BotTokenFile": "/etc/nodewatch/telegram.token",
      "ChatId": "IDE_JON_A_CHAT_ID",
      // info: a kiválasztási értesítések és a napi összesítés is; warning: csak a figyelmeztetések és a riasztások.
      "MinSeverity": "info"
    }
    // További kimenetek (a megfelelő titokfájllal):
    // { "Type": "safechat", "Url": "https://chat.example.com/api/ops/alerts", "TokenFile": "/etc/nodewatch/safechat.token", "MinSeverity": "info" },
    // { "Type": "matrix", "Homeserver": "https://matrix-client.matrix.org", "RoomId": "!szoba:matrix.org", "AccessTokenFile": "/etc/nodewatch/matrix.token", "MinSeverity": "warning" }
  ],

  "StateDirectory": "/var/lib/nodewatch",
  "VerboseLog": false
}
