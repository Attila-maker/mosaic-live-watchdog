// NodeWatch beállításai. Helye: /etc/nodewatch/appsettings.json
// A titkok (tokenek) NEM ide kerülnek, hanem külön fájlokba (0640, root:nodewatch), ide csak az útvonaluk.
{
  "Node": {
    "Name": "my-mosaic-node",
    "Network": "mosaic-mainnet",
    // A validátor SS58 címe (vagy 0x… nyilvános kulcsa). Üresen hagyva nincs validátorállapot-figyelés.
    "ValidatorAddress": "",
    // A beágyazott relay chain RPC-je (a Mosaic a 9954-es porton futtatja, csak biztonságos hívásokkal).
    "RelayRpc": "http://127.0.0.1:9954",
    "ParaRpc": "http://127.0.0.1:9944",
    "DataPath": "/var/lib/mosaic-mainnet",
    // Az első a chain (leállása kritikus), a többi csak figyelmeztet.
    "Services": [ "mosaic-chain-mainnet.service", "mosaic-indexer-mainnet.service" ]
  },

  "Checks": {
    "IntervalSeconds": 30,
    "RelayStallMinutes": 3,
    "FinalityStallMinutes": 5,
    "SyncWarnMinutes": 10,
    "ReminderMinutes": 30,
    "ConfirmPolls": 2,
    "DiskWarnPercent": 15,
    "DiskCriticalPercent": 5
  },

  // Watchdog: ha a felsorolt ellenőrzések valamelyike AfterMinutes percig folyamatosan kritikus,
  // újraindítja a chain szolgáltatást, de MinHoursBetween órán belül legfeljebb egyszer.
  "Restart": {
    "Enabled": true,
    "AfterMinutes": 10,
    "MinHoursBetween": 24,
    "GraceMinutes": 15,
    "Unit": "mosaic-chain-mainnet.service",
    "Command": [ "systemctl", "--no-ask-password", "--no-block", "restart", "mosaic-chain-mainnet.service" ],
    "Triggers": [ "relay.rpc", "relay.block_progress", "relay.full_peers", "para.rpc", "para.finality" ],
    "SkipWhileUnitsActive": [ "update-mosaic.service" ]
  },

  // direct: közvetlenül a Sinks kimenetekre; relay: csak a relay-re; both: relay + tartalék kimenetek.
  "Mode": "direct",

  "Relay": {
    "Url": "",
    "NodeTokenFile": "",
    "FallbackAfterMinutes": 2,
    "HeartbeatSeconds": 60,
    "Channels": []
  },

  "Sinks": [
    {
      "Type": "telegram",
      "BotTokenFile": "/etc/nodewatch/telegram.token",
      "ChatId": "IDE_JON_A_CHAT_ID",
      "MinSeverity": "warning"
    }
    // További kimenetek (a megfelelő titokfájllal):
    // { "Type": "safechat", "Url": "https://chat.example.com/api/ops/alerts", "TokenFile": "/etc/nodewatch/safechat.token", "MinSeverity": "warning" },
    // { "Type": "matrix", "Homeserver": "https://matrix-client.matrix.org", "RoomId": "!szoba:matrix.org", "AccessTokenFile": "/etc/nodewatch/matrix.token", "MinSeverity": "warning" }
  ],

  "StateDirectory": "/var/lib/nodewatch",
  "VerboseLog": false
}
