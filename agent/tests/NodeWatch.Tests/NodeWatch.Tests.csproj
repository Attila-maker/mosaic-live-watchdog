<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A small self-made test runner: no NuGet package is needed (dotnet run). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NodeWatch/NodeWatch.csproj" />
    <None Include="../../deploy/appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
